{
  "name": "netclaks",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch --experimental-strip-types --env-file=.env server/src/index.ts",
    "build": "npm run typecheck && vite build && npm run server:build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && npm run server:typecheck",
    "format": "prettier --write .",
    "preview": "vite preview",
    "server:build": "tsc --project server/tsconfig.json",
    "server:start": "node server/dist/index.js",
    "server:typecheck": "tsc --project server/tsconfig.json --noEmit",
    "db:migrate": "node --env-file-if-exists=.env server/dist/migrate.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "firebase": "^12.13.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.16.0",
    "pg": "8.22.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.15.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.8.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.0.12"
  }
}
